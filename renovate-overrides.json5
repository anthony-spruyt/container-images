{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // List every pip-compile lock here and in the pip_requirements rule below.
  "pip-compile": {
    "managerFilePatterns": ["llm-tool-guard-model/requirements.txt"],
    "lockFileMaintenance": {
      "schedule": ["before 4am on the first day of the month"],
    },
  },
  // Manager level on purpose: a packageRule can't enable lock file maintenance, as Renovate checks `enabled` before packageRules run.
  "pep621": {
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["before 4am on the first day of the month"],
    },
  },
  "packageRules": [
    // pip-compile owns this file and updates it with hashes; pip_requirements
    // would also match the lock file and open a second, hash-less PR.
    {
      "description": "Leave pip-compile lock files to the pip-compile manager",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["llm-tool-guard-model/requirements.txt"],
      "enabled": false,
    },
    // The torch pins differ by local version (+cpu vs +cu130) and live in two
    // apps, so Renovate would open one PR per variant; they must move together.
    {
      "description": "Group torch CPU and CUDA variant updates into one PR",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["torch"],
      "groupName": "torch",
      "group": {
        "commitMessageTopic": "torch (cpu + cuda)",
      },
    },
    // pep621 gives every torch pin all the indexes uv.sources lists, so a CPU pin
    // would move to a CUDA build; each variant is looked up on its own index.
    {
      "description": "Look up CPU torch pins on the CPU index",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["torch"],
      "matchCurrentValue": "/\\+cpu$/",
      "registryUrls": ["https://download.pytorch.org/whl/cpu"],
    },
    {
      "description": "Look up CUDA 13.0 torch pins on the CUDA 13.0 index; a new CUDA variant needs its own rule here and in pyproject.toml",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["torch"],
      "matchCurrentValue": "/\\+cu130$/",
      "registryUrls": ["https://download.pytorch.org/whl/cu130"],
    },
    {
      "description": "Label toolchain pins in MegaLinter language definitions like flavor pins",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["megalinter-factory/base.yaml", "megalinter-factory/languages/*.yaml"],
      "addLabels": ["renovate/megalinter-flavor"],
    },
    // A major floor would force past ranges that dependents pin exactly (effect 4 vs @prisma/config).
    {
      "description": "Keep happy-server dependency floors within their major",
      "matchFileNames": ["happy-server/Dockerfile"],
      "matchDepNames": ["@fastify/static", "deepmerge-ts", "effect", "sharp", "zod"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
    },
    // A caret range treats a 0.x minor as a major (sharp ^0.35.5 excludes 0.36), but Renovate calls it "minor".
    // Patches get their own bucket: Renovate keeps only the highest non-major update, so blocking it would hide them.
    {
      "description": "Offer happy-server 0.x dependency floor patches apart from their minors",
      "matchFileNames": ["happy-server/Dockerfile"],
      "matchDepNames": ["@fastify/static", "deepmerge-ts", "effect", "sharp", "zod"],
      "matchCurrentVersion": "/^0\\./",
      "separateMinorPatch": true,
    },
    {
      "description": "Keep happy-server 0.x dependency floors within their minor",
      "matchFileNames": ["happy-server/Dockerfile"],
      "matchDepNames": ["@fastify/static", "deepmerge-ts", "effect", "sharp", "zod"],
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": ["minor"],
      "enabled": false,
    },
    // release-please writes a CHANGELOG.md per image directory. Without
    // sourceDirectory Renovate looks for release notes at the repo root and
    // finds none, so updates to our own images render with an empty body.
    {
      "description": "Release notes for own images: chrony",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/chrony"],
      "sourceDirectory": "chrony",
    },
    {
      "description": "Release notes for own images: claude-agent-read",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/claude-agent-read"],
      "sourceDirectory": "claude-agent-read",
    },
    {
      "description": "Release notes for own images: claude-agent-spruyt-labs",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/claude-agent-spruyt-labs"],
      "sourceDirectory": "claude-agent-spruyt-labs",
    },
    {
      "description": "Release notes for own images: claude-agent-write",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/claude-agent-write"],
      "sourceDirectory": "claude-agent-write",
    },
    {
      "description": "Release notes for own images: coder-gitops",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/coder-gitops"],
      "sourceDirectory": "coder-gitops",
    },
    {
      "description": "Release notes for own images: devcontainer-common",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/devcontainer-common"],
      "sourceDirectory": "devcontainer-common",
    },
    {
      "description": "Release notes for own images: happy-server",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/happy-server"],
      "sourceDirectory": "happy-server",
    },
    {
      "description": "Release notes for own images: llm-guard",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/llm-guard"],
      "sourceDirectory": "llm-guard",
    },
    {
      "description": "Release notes for own images: llm-guard-cuda",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/llm-guard-cuda"],
      "sourceDirectory": "llm-guard-cuda",
    },
    {
      "description": "Release notes for own images: llm-tool-guard",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/llm-tool-guard"],
      "sourceDirectory": "llm-tool-guard",
    },
    {
      "description": "Release notes for own images: llm-tool-guard-model",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/llm-tool-guard-model"],
      "sourceDirectory": "llm-tool-guard-model",
    },
    {
      "description": "Release notes for own images: ssh-key-rotation",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/anthony-spruyt/ssh-key-rotation"],
      "sourceDirectory": "ssh-key-rotation",
    },
  ],
}
