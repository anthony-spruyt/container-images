#!/bin/bash
# agent-run: policy-enforcing wrapper around `podman run` for AI agents.
#
# Enforces safe defaults for images pulled and executed by agents:
#   - own user namespace (--userns=auto), so container root is not host root
#   - read-only root filesystem with /tmp + /var/tmp tmpfs
#   - no-new-privileges, all capabilities dropped
#   - private bridge network
#
# This is a guardrail, not a security boundary: the calling user has
# passwordless sudo. Isolation comes from the devcontainer / Kata VM.
#
# Usage:
#   agent-run [podman-run-args...] IMAGE [CMD...]

set -euo pipefail

# Rejected in any form (`--flag`, `--flag=value`, `--flag value`): each one
# overrides a namespace or privilege setting this wrapper owns.
readonly FORBIDDEN_FLAGS=(
  --privileged
  --pid
  --network
  --net
  --ipc
  --uts
  --userns
  --cgroupns
  --cap-add
  --pod
)

# Rejected substring patterns (matched anywhere in an arg). These are values
# that are unsafe in any flag context (e.g. mounting the docker socket).
readonly FORBIDDEN_SUBSTR=(
  "seccomp=unconfined"
  "apparmor=unconfined"
  "label=disable"
  "/var/run/docker.sock"
  "/run/docker.sock"
  "/run/podman/podman.sock"
)

is_forbidden_flag() {
  local f="$1"
  for flag in "${FORBIDDEN_FLAGS[@]}"; do
    [[ "$f" == "$flag" ]] && return 0
  done
  return 1
}

for arg in "$@"; do
  for pat in "${FORBIDDEN_SUBSTR[@]}"; do
    if [[ "$arg" == *"$pat"* ]]; then
      echo "agent-run: forbidden pattern in arg: $arg (matched: $pat)" >&2
      exit 64
    fi
  done

  if is_forbidden_flag "${arg%%=*}"; then
    echo "agent-run: forbidden flag: $arg" >&2
    exit 64
  fi
done

AGENT_NET="${AGENT_RUN_NET:-bridge}"
if [[ "$AGENT_NET" != bridge && "$AGENT_NET" != none ]]; then
  echo "agent-run: AGENT_RUN_NET must be bridge or none, got: $AGENT_NET" >&2
  exit 64
fi

# No cgroup limits (--memory, --pids-limit, --cpus): the nested cgroup tree
# is not delegated, so podman rejects them.
exec podman run --rm \
  --userns=auto \
  --read-only \
  --tmpfs /tmp:rw,exec,nosuid,nodev,size=256m \
  --tmpfs /var/tmp:rw,exec,nosuid,nodev,size=64m \
  --security-opt no-new-privileges \
  --cap-drop=ALL \
  --network="$AGENT_NET" \
  "$@"
