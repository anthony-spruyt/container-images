{
  "name": "Chrony Alpine Package Watcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 23
            }
          ]
        }
      },
      "name": "Daily Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -688,
        512
      ]
    },
    {
      "parameters": {
        "url": "https://raw.githubusercontent.com/anthony-spruyt/container-images/main/chrony/Dockerfile",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "name": "Get Dockerfile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -480,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse Alpine version from Dockerfile\nconst dockerfile = $input.first().json.data;\nconst match = dockerfile.match(/FROM\\s+alpine:(\\d+\\.\\d+)/);\nconst alpineVersion = match ? match[1] : null;\n\nif (!alpineVersion) {\n  return [{ json: { error: 'Could not parse Alpine version from Dockerfile' } }];\n}\n\nreturn [{ json: { alpineVersion } }];"
      },
      "name": "Parse Alpine Version",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        512
      ]
    },
    {
      "parameters": {
        "url": "=https://git.alpinelinux.org/aports/plain/main/chrony/APKBUILD?h={{ $json.alpineVersion }}-stable",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "name": "Get Alpine APKBUILD",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -32,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse chrony version from APKBUILD\nconst apkbuild = $input.first().json.data;\nconst alpineVersion = $('Parse Alpine Version').item.json.alpineVersion;\nconst pkgverMatch = apkbuild.match(/pkgver=([0-9.]+)/);\nconst pkgrelMatch = apkbuild.match(/pkgrel=([0-9]+)/);\n\nif (!pkgverMatch) {\n  return [{ json: { error: 'Could not parse pkgver from APKBUILD' } }];\n}\n\nconst pkgver = pkgverMatch[1];\nconst pkgrel = pkgrelMatch ? pkgrelMatch[1] : '0';\n\nreturn [{ json: { pkgver, pkgrel, fullVersion: `${pkgver}-r${pkgrel}`, alpineVersion } }];"
      },
      "name": "Parse APKBUILD",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        512
      ]
    },
    {
      "parameters": {
        "url": "https://raw.githubusercontent.com/anthony-spruyt/container-images/main/chrony/.alpine-chrony-version",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "neverError": true
            }
          }
        }
      },
      "name": "Get Recorded Version",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        192,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "// The image tag is now an independent semver line, so the Alpine package\n// version is tracked in chrony/.alpine-chrony-version instead of in tags.\nconst { pkgver, pkgrel, fullVersion, alpineVersion } = $('Parse APKBUILD').item.json;\n\nconst raw = $input.first().json.data;\nconst recorded = typeof raw === 'string' ? raw.trim() : '';\nconst known = /^[0-9][0-9.]*-r[0-9]+$/.test(recorded) ? recorded : null;\n\nreturn [{\n  json: {\n    isNew: known !== fullVersion,\n    version: pkgver,\n    fullVersion: fullVersion,\n    pkgver: pkgver,\n    pkgrel: pkgrel,\n    recordedVersion: known,\n    alpineVersion: alpineVersion,\n  },\n}];"
      },
      "name": "Check New Version",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        512
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-new-version",
              "leftValue": "={{ $json.isNew }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Is New Version?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        640,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build the issue body for a human to action; the workflow no longer\n// dispatches a build, because release-please owns versions now.\nconst { fullVersion, recordedVersion, alpineVersion } = $('Check New Version').item.json;\n\nconst body = [\n  'Alpine ' + alpineVersion + ' now ships chrony `' + fullVersion + '`.',\n  '',\n  'Recorded in `chrony/.alpine-chrony-version`: `' + (recordedVersion || 'none') + '`.',\n  '',\n  'To pick it up, open a PR that:',\n  '',\n  '1. updates `chrony/.alpine-chrony-version` to `' + fullVersion + '`',\n  '2. uses a conventional commit so release-please cuts a patch release, e.g.',\n  '   `fix(chrony): pick up chrony ' + fullVersion + ' from Alpine`',\n  '',\n  'The image tag is an independent semver line and does not encode this version.',\n].join('\\n');\n\nreturn [{\n  json: {\n    title: 'chrony ' + fullVersion + ' available in Alpine ' + alpineVersion,\n    body: body,\n  },\n}];"
      },
      "name": "Build Issue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        416
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/anthony-spruyt/container-images/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": {{ JSON.stringify($json.title) }},\n  \"body\": {{ JSON.stringify($json.body) }},\n  \"labels\": [\"dependencies\"]\n}",
        "options": {}
      },
      "name": "Open Issue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1072,
        416
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_ME",
          "name": "GitHub PAT"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "noreply@example.com",
        "toEmail": "CONFIGURE_ME@example.com",
        "subject": "=Chrony {{ $('Check New Version').item.json.fullVersion }} - issue opened",
        "options": {}
      },
      "name": "Send Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1296,
        416
      ],
      "credentials": {
        "smtp": {
          "id": "CONFIGURE_ME",
          "name": "SMTP"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Daily Check": {
      "main": [
        [
          {
            "node": "Get Dockerfile",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Dockerfile": {
      "main": [
        [
          {
            "node": "Parse Alpine Version",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Alpine Version": {
      "main": [
        [
          {
            "node": "Get Alpine APKBUILD",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Alpine APKBUILD": {
      "main": [
        [
          {
            "node": "Parse APKBUILD",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse APKBUILD": {
      "main": [
        [
          {
            "node": "Get Recorded Version",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Recorded Version": {
      "main": [
        [
          {
            "node": "Check New Version",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check New Version": {
      "main": [
        [
          {
            "node": "Is New Version?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is New Version?": {
      "main": [
        [
          {
            "node": "Build Issue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Issue": {
      "main": [
        [
          {
            "node": "Open Issue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Open Issue": {
      "main": [
        [
          {
            "node": "Send Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
